<?xml version="1.0" encoding="utf-8"?>
<!-- SEC-021: Cloud backup + device-transfer exclusions for secret prefs (API 31+). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="sharedpref"
            path="FlutterSecureStorage" />
        <exclude
            domain="sharedpref"
            path="FlutterSecureStorage.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="sharedpref"
            path="FlutterSecureStorage" />
        <exclude
            domain="sharedpref"
            path="FlutterSecureStorage.xml" />
    </device-transfer>
</data-extraction-rules>
